# Apache config for the Infomaniak web host. The site is static files pushed
# over FTP by .github/workflows/deploy.yml, so this file is the only place a
# response status, a redirect or a cache lifetime can be set at all.

# --- The custom 404 ------------------------------------------------------
# Without this line Apache answers every missing path with its own stock
# "Not Found" page. 404.html uses root-absolute URLs throughout, so it renders
# correctly under any requested path.
ErrorDocument 404 /404.html

# --- No directory listings -----------------------------------------------
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- One host, one protocol ------------------------------------------
  # TLS is terminated upstream, so Apache always sees plain HTTP on port 80 and
  # X-Forwarded-Proto is the only honest signal. The test is deliberately
  # positive (= http rather than != https): if the header ever stops being
  # sent, the rule does nothing instead of redirecting https to itself forever.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://keera.ch%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.keera\.ch$ [NC]
  RewriteRule ^ https://keera.ch%{REQUEST_URI} [R=301,L]

  # --- Language on the way in -------------------------------------------
  # French browsers to /fr/, German ones to the German root they already landed
  # on, everyone else to /en/. Only the home page negotiates: a deep link stays
  # on the page and language it names.
  #
  # Matching is on the first tag of Accept-Language, up to its separator, so the
  # Swiss variants come along for free - de-CH, fr-CH, de_CH, fr-FR. gsw is
  # Swiss German, which some Android builds send ahead of de-CH. Requiring the
  # separator keeps frr (Frisian) and the like out.
  #
  # Both rules skip a request referred from this site, so clicking DE in the
  # switcher is not bounced straight back to /fr/. Internal navigation wins over
  # the header: the switcher is a choice, Accept-Language is a guess.
  #
  # Redirects are absolute https:// URLs because Apache sees plain HTTP here: a
  # relative target would expand to http:// and cost a second redirect.
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?keera\.ch(/|$) [NC]
  RewriteCond %{HTTP:Accept-Language} ^\s*fr([-_,;]|$) [NC]
  RewriteRule ^(index\.html)?$ https://keera.ch/fr/ [R=302,L]

  # Anything that is not German - and not nothing. An empty or absent
  # Accept-Language is what a crawler sends, and it gets the German root, which
  # is what x-default points at.
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?keera\.ch(/|$) [NC]
  RewriteCond %{HTTP:Accept-Language} .
  RewriteCond %{HTTP:Accept-Language} !^\s*(de|gsw)([-_,;]|$) [NC]
  RewriteRule ^(index\.html)?$ https://keera.ch/en/ [R=302,L]
</IfModule>

# --- Cache lifetimes -----------------------------------------------------
# mod_headers rather than mod_expires: Infomaniak does not load mod_expires, so
# an <IfModule mod_expires.c> block is skipped silently. mod_headers matches on
# filename rather than MIME type.
<IfModule mod_headers.c>
  # The home page answers differently per Accept-Language, so every cache in
  # between has to key on that header. `always` puts it on the redirect as well
  # as on the German page; the plain table only covers 2xx.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/(index\.html)?$" KEERA_LANG_NEG=1
    Header always append Vary "Accept-Language" env=KEERA_LANG_NEG
  </IfModule>

  # A year, and immutable, because deploy stamps every asset URL with
  # ?v=<content hash> (.github/scripts/fingerprint-assets.py). A query string is
  # part of the cache key, so replacing a file in place changes the URL the
  # pages ask for and the old bytes are never requested again.
  <FilesMatch "\.(webp|jpe?g|png|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Pages carry the stamps, so they are the one thing that must stay fresh.
  # no-cache still allows a cheap ETag revalidation; it only forbids serving a
  # stale copy without asking.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # robots.txt and sitemap.xml
  <FilesMatch "\.(txt|xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
